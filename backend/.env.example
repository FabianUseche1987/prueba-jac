# Plantilla de configuración del backend.
# 1. Copia este archivo y llámalo .env (en esta misma carpeta).
# 2. Completa los valores. Los datos de la base de datos se piden al líder del equipo.
# El archivo .env NUNCA se sube a git (está en .gitignore).

# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Base de datos (MariaDB en Hostinger)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Sesiones (JWT)
# JWT_SECRET: clave secreta para firmar los tokens. Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
